# mTLS front end for the device API. NOT loaded by default.
#
# nginx refuses to start if any server block names a certificate file that does
# not exist -- and a failed nginx takes the OSTree repo down with it, so devices
# cannot pull at all. This lives apart until the device CA exists
# (DECISIONS.md D6). To enable: generate certs, mount them at /etc/nginx/certs,
# and add this file to the repo service's volumes in compose.yml.

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # --- device API: mutual TLS ---------------------------------------------
    ssl_client_certificate /etc/nginx/certs/device-ca.crt;
    ssl_verify_client      optional;   # 'on' once every device is provisioned
    ssl_verify_depth       2;

    location /api/v1/devices/ {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_set_header X-Device-CN $ssl_client_s_dn_cn;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_pass http://api:8000;
    }

    # --- operator API: bearer token, no client cert -------------------------
    location /api/v1/ {
        proxy_pass http://api:8000;
    }
}
